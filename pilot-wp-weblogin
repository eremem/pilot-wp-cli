def ok_page():
    return page("""<h1>Pilot WP</h1><p class=ok>Konto połączone ✓ Sesja jest zapisana na serwerze – możesz zamknąć tę stronę.
<span class=en>Account connected ✓ The session is saved on the server – you can close this page.</span></p>""")


def lan_ips():
    ips = set()
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))          # TEST-NET; UDP connect sends nothing
        ips.add(s.getsockname()[0]); s.close()
    except OSError:
        pass
    try:
        for info in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            ips.add(info[4][0])
    except OSError:
        pass
    return sorted(ip for ip in ips if not ip.startswith("127."))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--lib", required=True, help="directory of pilot-wp-common.sh")
    ap.add_argument("--port", type=int, default=8199)
    ap.add_argument("--bind", default="0.0.0.0")
    ap.add_argument("--timeout", type=float, default=15, help="minutes before giving up")
    args = ap.parse_args()

    code = f"{secrets.randbelow(10**6):06d}"
    state = {"done": False, "wrong": 0}

    class Handler(BaseHTTPRequestHandler):
        server_version = "pilot-wp-weblogin"
        sys_version = ""

        def log_message(self, fmt, *a):          # request line only; never bodies
            sys.stderr.write("weblogin: %s %s\n" % (self.client_address[0], fmt % a))

        def allowed(self):
            ip = ipaddress.ip_address(self.client_address[0])
            if ip.version == 6 and ip.ipv4_mapped:
                ip = ip.ipv4_mapped
            return ip.is_private or ip.is_loopback or ip.is_link_local

        def send(self, status, body):
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; "
                             "base-uri 'none'; frame-ancestors 'none'")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if not self.allowed():
                return self.send(403, page("<p>Forbidden</p>"))
            if self.path not in ("/", "/index.html"):
                return self.send(404, page("<p>Not found</p>"))
            self.send(200, form_page())

        def do_POST(self):
            if not self.allowed():
                return self.send(403, page("<p>Forbidden</p>"))
            if self.path != "/":
                return self.send(404, page("<p>Not found</p>"))
            length = int(self.headers.get("Content-Length") or 0)
            if length <= 0 or length > MAX_BODY:
                return self.send(413, form_page(("Za duże lub puste zgłoszenie.", "Empty or too large submission.")))
            form = parse_qs(self.rfile.read(length).decode("utf-8", "replace"), keep_blank_values=True)
            get = lambda k: (form.get(k) or [""])[0].strip()
            if not secrets.compare_digest(get("code").encode(), code.encode()):
                state["wrong"] += 1
                left = MAX_WRONG - state["wrong"]
                return self.send(403, form_page((f"Nieprawidłowy kod (pozostało prób: {left}).",
                                                  f"Wrong code ({left} attempts left).")))
            if get("curl"):
                payload = "curl\n" + get("curl") + "\n"
            elif get("id") and get("val"):
                payload = "values\n" + get("id") + "\n" + get("val") + "\n"
            else:
                return self.send(400, form_page(RESULT[10]))
            rc = subprocess.run(["bash", "-c", APPLY_SH, "_", args.lib], input=payload.encode(),
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60).returncode
            if rc == 0:
                state["done"] = True
                return self.send(200, ok_page())
            self.send(400 if rc == 10 else 502, form_page(RESULT.get(rc, (
                "Błąd wewnętrzny – sprawdź terminal serwera.", "Internal error – check the server's terminal."))))

    HTTPServer.allow_reuse_address = True
    try:
        srv = HTTPServer((args.bind, args.port), Handler)
    except OSError as e:
        print(f"pilot-wp-login --web: can't listen on {args.bind}:{args.port}: {e}", file=sys.stderr)
        return 4
    srv.timeout = 1

    hosts = lan_ips() if args.bind in ("0.0.0.0", "") else [args.bind]
    print("Open one of these addresses in a browser on your local network:")
    for h in hosts or ["<this server's IP>"]:
        print(f"    http://{h}:{args.port}/")
    print(f"One-time code: {code}   (valid {args.timeout:g} min; Ctrl-C to cancel)", flush=True)

    deadline = time.monotonic() + args.timeout * 60
    try:
        while not state["done"] and state["wrong"] < MAX_WRONG and time.monotonic() < deadline:
            srv.handle_request()
    except KeyboardInterrupt:
        print("\ncancelled", file=sys.stderr)
        return 1
    finally:
        srv.server_close()
    if state["done"]:
        return 0
    if state["wrong"] >= MAX_WRONG:
        print("pilot-wp-login --web: too many wrong codes; stopped.", file=sys.stderr)
        return 3
    print("pilot-wp-login --web: timed out; nothing changed.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
