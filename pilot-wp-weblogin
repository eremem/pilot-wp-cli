#!/usr/bin/env python3
# pilot-wp-weblogin --lib DIR [--port N] [--bind ADDR] [--timeout MIN]
#
# Temporary login page for pilot-wp-login --web. Serves a form on the local
# network where the user pastes a browser "Copy as cURL" of a pilot.wp.pl API
# request (the login itself has to happen on pilot.wp.pl: it is Cloudflare-
# Turnstile-gated). Each submission is handed to the library (parse_curl_cookies
# + install_session_cookies), which validates the session against the API before
# it replaces the jar. Python stdlib only.
#
# Safety: a one-time 6-digit code (printed on the box's terminal) must accompany
# every submission; only clients on private/loopback/link-local addresses are
# served; MAX_WRONG wrong codes stop the server; it exits after a successful login
# or after --timeout minutes. Submitted cookies are never logged.
#
# Exit codes: 0 logged in, 1 timed out, 3 too many wrong codes, 4 can't listen.
import argparse, html, ipaddress, secrets, socket, subprocess, sys, time
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs

MAX_WRONG = 5
MAX_BODY = 256 * 1024

# Runs inside the suite's library: parse the submission, then validate + install.
# Exit: 0 installed, 1 rejected by the API, 2 API unreachable, 9 lib error, 10 no cookies.
APPLY_SH = r'''
source "$1/pilot-wp-common.sh" || exit 9
IFS= read -r mode || exit 10
if [[ "$mode" == curl ]]; then
    parsed=$(parse_curl_cookies 2>/dev/null) || exit 10
    id=${parsed%%$'\t'*}; val=${parsed#*$'\t'}
else
    IFS= read -r id || true; IFS= read -r val || true
    id=$(printf '%s' "$id"   | tr -cd 'A-Za-z0-9._:-')
    val=$(printf '%s' "$val" | tr -cd 'A-Za-z0-9._-')
fi
[[ -n "$id" && -n "$val" ]] || exit 10
install_session_cookies "$id" "$val"
'''

