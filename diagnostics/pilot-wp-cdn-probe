#!/usr/bin/env bash
# pilot-wp-cdn-probe [--dash|--hls] [--wait SECS] [--live SECS] CHANNEL_ID [N_SEGS]
#
# Diagnostic for a channel that stutters (DTS discontinuities, segments fetched
# slower than real time). It answers: can THIS box pull the channel's segments
# fast enough to keep up with live, and if not, where does the time go — the data
# path (link RTT / throughput) or connection setup (TCP/TLS handshake, nf_conntrack)?
#
# Run it on the box while a tune is stuttering. It resolves the channel like
# pilot-wp-stream (cookie jar, fetch_channel, impersonation UA) and probes the path
# pilot-wp-stream would play it through:
#
#   DASH  DRM channels, and free-to-air ones by default (pilot-wp-dashlive)
#   HLS   the free-to-air fallback (no DASH URL, PILOT_WP_FTA_DASH=0, or no
#         dashlive/python3) — ffmpeg's own HLS demuxer
#
# --dash / --hls force a path instead (free-to-air only; DRM plays only via DASH),
# e.g. to compare the two before changing PILOT_WP_FTA_DASH. It then times the
# latest media segments of the top video rendition and the audio, two ways:
#
#   WARM  one reused keep-alive connection, as the production fetcher uses — WARM
#         ms/seg must stay under the segment duration for smooth playback.
#   COLD  a fresh connection per segment — isolates connect+handshake cost.
#
# WARM and COLD fetch DIFFERENT segments (alternate ones of the same recent run),
# interleaved in time: neither re-fetches a segment the other just pulled (which the
# CDN node would serve from cache), and both see the same moment's network. Reading:
#   COLD slow, WARM fast  => new-connection setup (full nf_conntrack table / socket
#                            buildup; a reboot clears it)
#   WARM slow, COLD fast  => long-lived connections stall or get dropped on the way
#                            (router/NAT/Wi-Fi, or the CDN node) — not bandwidth
#   both slow             => the link path itself (latency or bandwidth)
#
# The slot opened to read the manifest is released immediately, unless the URL is
# token-gated (videostar: its tokens die with the session); then it is held, with
# heartbeats, until the probe exits.
#
# A short manifest window (a handful of long segments, e.g. videostar's 5 s ones)
# lists fewer than N_SEGS pairs. The probe then re-reads the manifest and times
# segments as they are published — video and audio in the same rounds, as
# pilot-wp-dashlive fetches them — until it has N_SEGS per mode or --wait SECS
# (default 90, 0 = off) runs out.
#
# Those timings are a burst of a few seconds: they measure throughput, but an
# unstable link (a modem dropping out for seconds at a time) sails through them
# while playback stalls. So the probe then watches the link for --live SECS
# (default 60, 0 = off), polling like pilot-wp-dashlive in steady state: the
# manifest once per segment duration (through the CDN's redirector), every newly
# published segment on the keep-alive connection, and the Pilot WP API every 10 s
# (heartbeats and a re-tune's key fetch need it). Failures, slow fetches and gaps
# with no new segment are printed as they happen and feed the VERDICT. Deps: the
# suite's own (curl, jq) plus python3 stdlib.
set -euo pipefail

usage="usage: pilot-wp-cdn-probe [--dash|--hls] [--wait SECS] [--live SECS] CHANNEL_ID [N_SEGS]"
force="" wait=90 live=60 args=()
while (( $# )); do
    case "$1" in
        --dash|--hls) force=${1#--} ;;
        --wait)       [[ $# -ge 2 ]] || { echo "$usage" >&2; exit 2; }; wait=$2; shift ;;
        --wait=*)     wait=${1#*=} ;;
        --live)       [[ $# -ge 2 ]] || { echo "$usage" >&2; exit 2; }; live=$2; shift ;;
        --live=*)     live=${1#*=} ;;
        -h|--help)    echo "$usage"; exit 0 ;;
        -*)           echo "pilot-wp-cdn-probe: unknown option $1" >&2; echo "$usage" >&2; exit 2 ;;
        *)            args+=("$1") ;;
    esac
    shift
done
channel_id="${args[0]:-}"
nseg="${args[1]:-8}"
[[ -n "$channel_id" ]] || { echo "$usage" >&2; exit 2; }
[[ "$nseg" =~ ^[1-9][0-9]*$ ]] || { echo "pilot-wp-cdn-probe: N_SEGS must be a positive integer" >&2; exit 2; }
[[ "$wait" =~ ^[0-9]+$ ]] || { echo "pilot-wp-cdn-probe: --wait takes whole seconds (0 = don't wait)" >&2; exit 2; }
[[ "$live" =~ ^[0-9]+$ ]] || { echo "pilot-wp-cdn-probe: --live takes whole seconds (0 = off)" >&2; exit 2; }

_self_dir=$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")" && pwd)
# shellcheck source=pilot-wp-common.sh
source "$_self_dir/../pilot-wp-common.sh"

PY="${PILOT_WP_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || { echo "pilot-wp-cdn-probe: needs python3 ($PY not found)" >&2; exit 1; }

# Only fall back to resolve_auth when the jar is missing/empty, so a normal box
# run stays non-interactive.
if [[ ! -s "$PILOT_WP_COOKIES" ]]; then
    resolve_auth || { echo "pilot-wp-cdn-probe: no usable session (run pilot-wp-login)" >&2; exit 1; }
fi

hb_pid="" token=""
# Free the slot (and stop its heartbeat) — on every exit path, Ctrl-C included.
release_slot() {
    [[ -n "$hb_pid" ]] && kill "$hb_pid" 2>/dev/null
    [[ -n "$token" ]] && release_stream "$channel_id" "$token" >/dev/null 2>&1
    hb_pid="" token=""
}
trap release_slot EXIT
trap 'exit 130' INT TERM

mapfile -t REC < <(fetch_channel "$channel_id")
status=${REC[0]:-error}
hls_url=${REC[1]:-}
hb_url=${REC[2]:-}
hb_interval=${REC[3]:-}
token=${REC[4]:-}
ch_name=${REC[5]:-}
dash_url=${REC[6]:-}

echo "pilot-wp-cdn-probe: channel $channel_id (${ch_name:-?})  status=$status"
case "$status" in
    drm)   kind=DRM ;;
    ok)    kind=FTA ;;
    limit) echo "  -> multiroom limit reached; can't open the channel to read its manifest right now."; exit 0 ;;
    *)     echo "  -> could not resolve channel (status=$status); is the session valid? try pilot-wp-login." >&2; exit 1 ;;
esac

# The path pilot-wp-stream takes for this channel (mirrors its `case "$status"`).
if [[ "$kind" == DRM ]]; then
    prod=dash why="DRM channels always play through DASH"
elif [[ -n "$dash_url" ]] && fta_dash_available; then
    prod=dash why="free-to-air, DASH available"
elif [[ -z "$dash_url" ]]; then
    prod=hls why="free-to-air, no DASH URL"
elif [[ "${PILOT_WP_FTA_DASH:-1}" != 1 ]]; then
    prod=hls why="free-to-air, PILOT_WP_FTA_DASH=${PILOT_WP_FTA_DASH}"
else
    prod=hls why="free-to-air, pilot-wp-dashlive or $PY unavailable"
fi
path=${force:-$prod}
if [[ "$kind" == DRM && "$path" == hls ]]; then
    echo "  -> DRM channels play only through DASH; --hls doesn't apply." >&2; exit 2
fi
if [[ "$path" == dash ]]; then url=$dash_url; else url=$hls_url; fi
[[ -n "$url" ]] || { echo "  -> no ${path^^} URL in the channel response." >&2; exit 1; }

# Token-gated (videostar) URLs die with the session, so hold the slot for the run
# and keep it alive with heartbeats (the run is well inside the ~3 min before
# pilot-wp-stream would need a session switch). Token-less (redcdn) URLs outlive
# the session: free the slot at once.
gated=0
if is_token_gated "$url"; then
    gated=1
    slot="held for the run (token-gated URL), released on exit"
    if [[ -n "$hb_url" ]]; then
        [[ "$hb_interval" =~ ^[0-9]+$ ]] || hb_interval=20
        ( while sleep "$hb_interval"; do heartbeat_once "$hb_url" >/dev/null 2>&1 || true; done ) &
        hb_pid=$!
    fi
else
    release_slot
    slot="released (URL not token-gated)"
fi

if [[ -z "$force" ]]; then
    note="what pilot-wp-stream uses: $why"
elif [[ "$force" == "$prod" ]]; then
    note="forced; pilot-wp-stream uses it too: $why"
else
    note="forced; pilot-wp-stream uses ${prod^^}: $why"
fi
echo "  type:     $kind"
echo "  path:     ${path^^}  ($note)"
echo "  url:      $url"
echo "  slot:     $slot"
echo "  UA:       $PILOT_WP_UA"
echo "  sampling: $nseg segments per track for WARM and $nseg different ones for COLD, interleaved,"
if (( wait > 0 )); then
    echo "            from the newest published ones; on a short manifest window, waits up to ${wait}s"
    echo "            for newly published segments"
else
    echo "            from the newest published ones (--wait 0: only those already listed)"
fi
if (( live > 0 )); then
    echo "  live:     then ${live}s polling like pilot-wp-dashlive, to catch an unstable link (--live 0: off)"
fi
echo

"$PY" - "$path" "$url" "$PILOT_WP_UA" "$nseg" "$wait" "$live" "$gated" "$USER_URL" <<'PY'
import sys, re, time, ssl, http.client, urllib.request, urllib.parse, urllib.error
import xml.etree.ElementTree as ET
from datetime import datetime

T_START = time.monotonic()
mode, url, ua, nseg, wait = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4] or "8"), int(sys.argv[5] or "90")
live_secs, gated, api_url = int(sys.argv[6] or "0"), sys.argv[7] == "1", sys.argv[8]
ln  = lambda t: t.rsplit("}", 1)[-1]
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE

def get(u):
    req = urllib.request.Request(u, headers={"User-Agent": ua})
    t0 = time.monotonic()
    with urllib.request.urlopen(req, timeout=20, context=ctx) as r:
        return r.read(), r.geturl(), time.monotonic() - t0

def split_url(u):
    p = urllib.parse.urlparse(u)
    return (p.scheme, p.netloc), p.path + ("?" + p.query if p.query else "")

def new_conn(host):
    scheme, netloc = host
    if scheme == "https":
        return http.client.HTTPSConnection(netloc, timeout=20, context=ctx)
    return http.client.HTTPConnection(netloc, timeout=20)

class Track:
    # One probed rendition: its WARM connection, running totals and output lines.
    # Segments are (key, url), oldest first; keys ($Time$, $Number$ or the HLS media
    # sequence) only grow, which is how newly published ones are spotted.
    def __init__(self, label, bw, seg_dur, note, segs):
        self.label, self.bw, self.seg_dur, self.note = label, bw, seg_dur, note
        self.lines, self.extra = [], []
        self.host = self.conn = None
        self.wb = self.wt = self.wx = 0.0; self.n_ok = self.reconnects = self.warm_err = 0
        self.cc = self.ct = self.cx = 0.0; self.ck = self.cold_err = 0
        # Backlog: the newest 2*N listed segments as (WARM, COLD) pairs of neighbours,
        # so neither mode re-fetches a segment the CDN just served to the other. An
        # odd count drops the oldest.
        run = segs[-2 * nseg:]
        run = run[len(run) % 2:]
        self.queue = [(run[i], run[i + 1]) for i in range(0, len(run), 2)]
        self.backlog, self.pairs, self.pending = len(self.queue), 0, []
        self.last = segs[-1][0] if segs else None

    def need(self):
        return self.pairs + len(self.queue) < nseg

    def feed(self, segs):
        # Queue pairs from the segments published since the last look.
        new = [s for s in segs if self.last is None or s[0] > self.last]
        if new: self.last = new[-1][0]
        self.pending += new
        while len(self.pending) >= 2 and self.need():
            self.queue.append((self.pending[0], self.pending[1])); del self.pending[:2]

    def drain(self):
        while self.queue:
            (kw, uw), (kc, uc) = self.queue.pop(0)
            self.fetch_warm(kw, uw); self.fetch_cold(kc, uc); self.pairs += 1

    def fetch_warm(self, k, u):
        # One reused keep-alive connection (mirrors the production fetcher; a new one
        # only when the segment host changes).
        h, path = split_url(u)
        if h != self.host:
            if self.conn: self.conn.close()
            self.host, self.conn = h, new_conn(h)
        try:
            t0 = time.monotonic(); self.conn.request("GET", path, headers={"User-Agent": ua})
            r = self.conn.getresponse(); t1 = time.monotonic(); data = r.read(); t2 = time.monotonic()
        except Exception as e:
            self.reconnects += 1
            try: self.conn.close()
            except Exception: pass
            self.conn = new_conn(self.host)
            self.lines.append(f"   warm seg {k}: RECONNECT after {type(e).__name__}: {e}")
            return
        if r.status != 200:
            self.warm_err += 1
            self.lines.append(f"   warm seg {k}: HTTP {r.status}")
            return
        ttfb, xfer = t1 - t0, t2 - t1
        self.wb += len(data); self.wt += ttfb; self.wx += xfer; self.n_ok += 1
        self.lines.append(f"   warm seg {k}: {len(data)/1024:7.1f} KB  TTFB={ttfb*1000:6.0f}ms  "
                          f"xfer={xfer*1000:6.0f}ms  total={(ttfb+xfer)*1000:6.0f}ms")

    def fetch_cold(self, k, u):
        # A fresh connection per segment: connect + handshake counted.
        host, path = split_url(u)
        try:
            t0 = time.monotonic()
            c = new_conn(host); c.connect()
            tC = time.monotonic(); c.request("GET", path, headers={"User-Agent": ua})
            r = c.getresponse(); tH = time.monotonic(); data = r.read(); tD = time.monotonic(); c.close()
        except Exception as e:
            self.cold_err += 1
            self.lines.append(f"   cold seg {k}: ERROR {type(e).__name__}: {e}")
            return
        if r.status != 200:
            self.cold_err += 1
            self.lines.append(f"   cold seg {k}: HTTP {r.status}")
            return
        self.cc += tC - t0; self.ct += tH - tC; self.cx += tD - tH; self.ck += 1
        self.lines.append(f"   cold seg {k}: {len(data)/1024:7.1f} KB  connect={(tC-t0)*1000:5.0f}ms  "
                          f"TTFB={(tH-tC)*1000:6.0f}ms  xfer={(tD-tH)*1000:6.0f}ms  total={(tD-t0)*1000:6.0f}ms")

    def report(self):
        if self.conn: self.conn.close()
        sd, live = self.seg_dur, self.pairs - self.backlog
        got = f"n={self.pairs} per mode" + (f" of {nseg} wanted" if self.pairs < nseg else "") \
              + (f", {live} awaited live" if live else "")
        print(f"== {self.label}  {self.note}{f'bw={self.bw/1e6:.3f} Mbps  ' if self.bw else ''}"
              f"seg_dur={sd:.2f}s (must fetch each seg in <= {sd:.2f}s to keep up)  {got} ==")
        for l in self.lines: print(l)
        k = self.n_ok or 1
        warm_per = (self.wt + self.wx) / k
        mbps = self.wb * 8 / 1e6 / (self.wt + self.wx) if (self.wt + self.wx) else 0
        print(f"   WARM avg: TTFB {self.wt/k*1000:.0f}ms + xfer {self.wx/k*1000:.0f}ms = {warm_per*1000:.0f}ms/seg "
              f"({mbps:.1f} Mbps){'  RECONNECTS=' + str(self.reconnects) if self.reconnects else ''}"
              f"{'  ERRORS=' + str(self.warm_err) if self.warm_err else ''}")
        kc = self.ck or 1
        cold_per = (self.cc + self.ct + self.cx) / kc
        print(f"   COLD avg: connect {self.cc/kc*1000:.0f}ms + TTFB {self.ct/kc*1000:.0f}ms + xfer {self.cx/kc*1000:.0f}ms "
              f"= {cold_per*1000:.0f}ms/seg{'  ERRORS=' + str(self.cold_err) if self.cold_err else ''}\n")
        for l in self.extra: print(l)
        return dict(label=self.label, seg_dur=sd, warm=warm_per, cold=cold_per,
                    warm_ttfb=self.wt/k, warm_xfer=self.wx/k, reconnects=self.reconnects,
                    warm_ok=self.n_ok, cold_ok=self.ck, warm_err=self.warm_err, cold_err=self.cold_err)

def sample(tracks, refresh):
    # The listed backlog first. While a track is still short of N pairs (a short
    # manifest window), re-read the manifest every half segment and time segments as
    # they are published — all tracks in the same rounds, as pilot-wp-dashlive
    # fetches them — until every track has N or `wait` seconds pass.
    for t in tracks: t.drain()
    if wait <= 0 or not any(t.need() for t in tracks):
        return
    short = ", ".join(f"{t.label} {t.pairs}" for t in tracks if t.need())
    print(f"short manifest window ({short} of {nseg} pairs listed): waiting up to {wait}s for newly "
          f"published segments ...", flush=True)
    t0 = time.monotonic()
    while any(t.need() for t in tracks) and time.monotonic() - t0 < wait:
        time.sleep(max(1.0, min(t.seg_dur for t in tracks if t.need()) / 2))
        try:
            lists = refresh()
        except Exception as e:
            print(f"   manifest refresh failed ({type(e).__name__}: {e}); stopped waiting")
            break
        for t in tracks:
            if t.need() and t.label in lists:
                t.feed(lists[t.label]); t.drain()
    print(f"   waited {time.monotonic() - t0:.0f}s\n", flush=True)

# ---- DASH (pilot-wp-dashlive) --------------------------------------------------
def track_sets(scope, ct):
    # As pilot-wp-dashlive: contentType first, mimeType prefix as the fallback.
    sets = [a for a in scope.iter() if ln(a.tag) == "AdaptationSet" and a.attrib.get("contentType") == ct]
    return sets or [a for a in scope.iter()
                    if ln(a.tag) == "AdaptationSet" and a.attrib.get("mimeType", "").startswith(ct)]

def ast_epoch(root):
    s = root.attrib.get("availabilityStartTime")
    try: return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp() if s else 0.0
    except Exception: return 0.0

def iso_dur(s, default):
    m = re.fullmatch(r"PT(?:([\d.]+)H)?(?:([\d.]+)M)?(?:([\d.]+)S)?", s or "")
    if not m or not any(m.groups()): return default
    h, mi, se = (float(x or 0) for x in m.groups())
    return h * 3600 + mi * 60 + se

def dash_segments(root, tmpl):
    # Published segment keys, the media placeholder and the segment duration (s),
    # mirroring pilot-wp-dashlive's list_segments: SegmentTimeline + $Time$, or
    # SegmentTemplate@duration + $Number$ (index derived from the wall clock).
    scale = float(tmpl.attrib.get("timescale", "1") or "1")
    media = tmpl.attrib["media"]
    stl = next((e for e in tmpl.iter() if ln(e.tag) == "SegmentTimeline"), None)
    if stl is not None and "$Time$" in media:
        times, t, d = [], None, None
        for s in (e for e in stl if ln(e.tag) == "S"):
            if "t" in s.attrib: t = int(s.attrib["t"])
            d = int(s.attrib["d"]); r = int(s.attrib.get("r", "0"))
            for _ in range(r + 1):
                times.append(t); t += d
        # Skip the last two: listed but possibly not fully published yet.
        usable = times[:-2] if len(times) > 2 else times[:-1]
        return usable, "$Time$", (d / scale if d else 2.0)
    dur = float(tmpl.attrib.get("duration", "0") or "0")
    seg_dur = dur / scale if dur else 4.0
    start_n = int(tmpl.attrib.get("startNumber", "1") or "1")
    tsbd = iso_dur(root.attrib.get("timeShiftBufferDepth"), 60.0)
    live_n = start_n + int((time.time() - ast_epoch(root)) / seg_dur) - 1   # last fully-published
    first_n = max(start_n, live_n - int(tsbd / seg_dur) + 1)
    # Skip the newest one too (a publish race), like the $Time$ branch.
    return list(range(first_n, live_n)), "$Number$", seg_dur

def bwof(rep):
    return int(rep.attrib.get("bandwidth", "0"))

def load_mpd():
    raw, eff, mpd_t = get(url)
    root = ET.fromstring(raw)
    base = next((e.text.strip() for e in root.iter() if ln(e.tag) == "BaseURL" and e.text), eff)
    return root, base, mpd_t

def dash_tracks(root, base):
    # {LABEL: (reps, rep, segs, seg_dur, placeholder)} for the live-edge Period's first
    # video set (top rendition) and first audio set (first rendition).
    periods = [e for e in root.iter() if ln(e.tag) == "Period"]
    period  = periods[-1] if periods else root
    out = {}
    for ct in ("video", "audio"):
        sets = track_sets(period, ct)
        if not sets:
            continue
        aset = sets[0]
        reps = [e for e in aset.iter() if ln(e.tag) == "Representation"]
        rep  = max(reps, key=bwof) if ct == "video" else reps[0]
        tmpl = next(e for e in aset.iter() if ln(e.tag) == "SegmentTemplate")
        keys, ph, seg_dur = dash_segments(root, tmpl)
        media = (tmpl.attrib["media"].replace("$RepresentationID$", rep.attrib["id"])
                                     .replace("$Bandwidth$", rep.attrib.get("bandwidth", "0")))
        out[ct.upper()] = (reps, rep, [(k, base + media.replace(ph, str(k))) for k in keys], seg_dur, ph)
    return out

def run_dash():
    root, base, mpd_t = load_mpd()
    node = urllib.parse.urlparse(base).netloc
    print(f"node: {node}   MPD fetch {mpd_t*1000:.0f}ms   "
          f"periods={sum(1 for e in root.iter() if ln(e.tag) == 'Period')}\n")
    tracks = []
    for label, (reps, rep, segs, seg_dur, ph) in dash_tracks(root, base).items():
        t = Track(label, bwof(rep), seg_dur, f"rep id={rep.attrib['id']}  {ph}  ", segs)
        if label == "VIDEO":
            ladder = sorted(bwof(r) for r in reps)
            t.extra.append("   video ladder (Mbps): " + ", ".join(f"{b/1e6:.3f}" for b in ladder))
            lower = [b for b in ladder if b < max(ladder)]
            if lower:
                t.extra.append(f"   -> PILOT_WP_DASHLIVE_ARGS=\"--max-video-bw {lower[-1]}\" would drop to "
                               f"the {lower[-1]/1e6:.3f} Mbps rung\n")
        tracks.append(t)
    def refresh():
        root, base, _ = load_mpd()
        return {label: v[2] for label, v in dash_tracks(root, base).items()}
    return tracks, refresh, node

# ---- HLS (the free-to-air fallback: ffmpeg's HLS demuxer) -----------------------
ATTR = re.compile(r'([A-Z0-9-]+)=("[^"]*"|[^",]*)')
def attrs(line):
    return {k: v.strip('"') for k, v in ATTR.findall(line.split(":", 1)[1])}

def media_playlist(u):
    # Segment URLs (relative ones resolved like ffmpeg: against the playlist URL)
    # keyed by media sequence number, and the mean #EXTINF duration.
    raw, eff, pt = get(u)
    seq, durs, segs, dur = 0, [], [], None
    for line in raw.decode("utf-8", "replace").splitlines():
        line = line.strip()
        if line.startswith("#EXT-X-MEDIA-SEQUENCE:"):
            seq = int(line.split(":", 1)[1])
        elif line.startswith("#EXTINF:"):
            dur = float(line[8:].split(",")[0])
        elif line and not line.startswith("#"):
            segs.append((seq + len(segs), urllib.parse.urljoin(eff, line))); durs.append(dur or 0.0)
    seg_dur = sum(durs) / len(durs) if durs else 2.0
    return segs, seg_dur, pt

def run_hls():
    raw, eff, mt = get(url)
    text = raw.decode("utf-8", "replace")
    specs = []   # (label, bandwidth, playlist url)
    ladder = []
    if "#EXT-X-STREAM-INF" not in text:
        specs.append(("STREAM", 0, eff))   # a bare media playlist
    else:
        lines = [l.strip() for l in text.splitlines()]
        variants, audio = [], []
        for i, l in enumerate(lines):
            if l.startswith("#EXT-X-STREAM-INF:"):
                uri = next((x for x in lines[i + 1:] if x and not x.startswith("#")), None)
                if uri: variants.append((attrs(l), urllib.parse.urljoin(eff, uri)))
            elif l.startswith("#EXT-X-MEDIA:"):
                a = attrs(l)
                if a.get("TYPE") == "AUDIO" and a.get("URI"):
                    audio.append((a, urllib.parse.urljoin(eff, a["URI"])))
        vbw   = lambda v: int(v[0].get("BANDWIDTH", "0"))
        video = [v for v in variants if "RESOLUTION" in v[0]]
        if video:
            top = max(video, key=vbw)
            specs.append(("VIDEO" if audio else "STREAM", vbw(top), top[1]))
            ladder = sorted(map(vbw, video))
            # The top variant's audio group, its DEFAULT=YES rendition first.
            group = [x for x in audio if x[0].get("GROUP-ID") == top[0].get("AUDIO")] or audio
            if group:
                pick = next((x for x in group if x[0].get("DEFAULT") == "YES"), group[0])
                specs.append(("AUDIO", 0, pick[1]))
        elif variants:
            top = max(variants, key=vbw)   # audio-only (radio): its top rung
            specs.append(("AUDIO", vbw(top), top[1]))
    node = urllib.parse.urlparse(specs[0][2]).netloc if specs else "?"
    print(f"node: {node}   playlist fetch {mt*1000:.0f}ms"
          f"{'   (audio muxed into the video segments)' if specs and specs[0][0] == 'STREAM' else ''}")
    if ladder:
        print("video ladder (Mbps): " + ", ".join(f"{b/1e6:.3f}" for b in ladder))
    print()
    tracks = []
    for label, bw, pu in specs:
        segs, seg_dur, pt = media_playlist(pu)
        tracks.append(Track(label, bw, seg_dur, f"playlist {pt*1000:.0f}ms  ", segs))
    def refresh():
        return {label: media_playlist(pu)[0] for label, _, pu in specs}
    return tracks, refresh, node

# ---- live stability (--live) ---------------------------------------------------
API_EVERY = 10   # seconds between Pilot WP API checks

class Stat:
    # One component of the live run (the manifest, a track, the API): counts and
    # timings, its problems printed as they happen. A fetch slower than `budget`
    # seconds is flagged.
    def __init__(s, name, budget):
        s.name, s.budget = name, budget
        s.n = s.fail = s.slow = 0; s.tot = s.max = s.gap = 0.0

    def add(s, at, dt, err=None, what=""):
        s.n += 1
        if err:
            s.fail += 1
            print(f"   [{at:6.1f}s] {s.name}{what}: FAILED after {dt*1000:.0f}ms - {err}", flush=True)
            return
        s.tot += dt; s.max = max(s.max, dt)
        if dt > s.budget:
            s.slow += 1
            print(f"   [{at:6.1f}s] {s.name}{what}: {dt*1000:.0f}ms (over the {s.budget*1000:.0f}ms budget)",
                  flush=True)

    def line(s, extra=""):
        ok = s.n - s.fail
        avg = f"avg {s.tot/ok*1000:.0f}ms, max {s.max*1000:.0f}ms" if ok else "none succeeded"
        print(f"   {s.name:12s} {s.n:3d} fetches, {s.fail} failed, {s.slow} slow; {avg}{extra}")

def live_seg(t, u):
    # One segment on the track's keep-alive connection, as pilot-wp-dashlive fetches
    # it. Returns (seconds, error or None); a dropped connection is reopened.
    h, path = split_url(u)
    if h != t.host:
        if t.conn: t.conn.close()
        t.host, t.conn = h, new_conn(h)
    t0 = time.monotonic()
    try:
        t.conn.request("GET", path, headers={"User-Agent": ua})
        r = t.conn.getresponse(); r.read()
    except Exception as e:
        try: t.conn.close()
        except Exception: pass
        t.conn = new_conn(t.host)
        return time.monotonic() - t0, f"{type(e).__name__}: {e} (connection dropped)"
    return time.monotonic() - t0, (None if r.status == 200 else f"HTTP {r.status}")

def api_check():
    # Any HTTP answer means the API is reachable. No cookie is sent: an anonymous
    # /api/v2/user just returns data:null and touches no session.
    t0 = time.monotonic()
    try:
        get(api_url)
    except urllib.error.HTTPError:
        pass
    except Exception as e:
        return time.monotonic() - t0, f"{type(e).__name__}: {e}"
    return time.monotonic() - t0, None

def live(tracks, refresh):
    # pilot-wp-dashlive's steady state for live_secs: the manifest once per segment
    # duration, each newly published segment of every track, and the API every
    # API_EVERY s. A track's gap is the time between two of its segments arriving;
    # beyond 3 segment durations playback has used up its slack and stalls.
    secs = live_secs
    if gated:
        # Videostar tokens are revoked a few minutes into a session: stay inside
        # that, or the run ends in 403s that are not the link's fault.
        secs = min(secs, max(0, int(150 - (time.monotonic() - T_START))))
        if secs < live_secs:
            print(f"LIVE  shortened to {secs}s: the token-gated URL expires a few minutes into the session")
    if secs <= 0:
        return None
    cad = min(t.seg_dur for t in tracks)
    print(f"LIVE  {secs}s polling like pilot-wp-dashlive: manifest every {cad:.1f}s, new segments on one "
          f"keep-alive connection per track, Pilot WP API every {API_EVERY}s. Problems as they happen:",
          flush=True)
    man = Stat("manifest", cad)
    api = Stat("Pilot WP API", 5.0)
    st = {t.label: Stat(t.label, t.seg_dur) for t in tracks}
    for t in tracks:            # report() closed the burst connections
        t.host = t.conn = None
    t0 = time.monotonic()
    last_ok = {t.label: t0 for t in tracks}
    next_api = t0
    try:
        while time.monotonic() - t0 < secs:
            cs = time.monotonic()
            if api_url and cs >= next_api:
                next_api = cs + API_EVERY
                dt, err = api_check(); api.add(cs - t0, dt, err)
            rs = time.monotonic()
            try:
                lists = refresh()
                man.add(rs - t0, time.monotonic() - rs)
            except Exception as e:
                man.add(rs - t0, time.monotonic() - rs, f"{type(e).__name__}: {e}")
                lists = {}
            for t in tracks:
                for k, u in [s for s in lists.get(t.label, []) if t.last is None or s[0] > t.last]:
                    if time.monotonic() - t0 >= secs:
                        break
                    at = time.monotonic() - t0
                    dt, err = live_seg(t, u); t.last = k
                    st[t.label].add(at, dt, err, f" seg {k}")
                    if not err:
                        now = time.monotonic()
                        st[t.label].gap = max(st[t.label].gap, now - last_ok[t.label])
                        last_ok[t.label] = now
            rest = cad - (time.monotonic() - cs)
            if rest > 0:
                time.sleep(rest)
    except KeyboardInterrupt:
        print("   (interrupted)")
    end = time.monotonic()
    for t in tracks:
        st[t.label].gap = max(st[t.label].gap, end - last_ok[t.label])
        if t.conn: t.conn.close()
    print(f"   --- after {end - t0:.0f}s:")
    man.line()
    for t in tracks:
        st[t.label].line(f"; longest gap between segments {st[t.label].gap:.1f}s "
                         f"(stalls beyond {3*t.seg_dur:.0f}s)")
    if api_url:
        api.line()
    print()
    return dict(secs=end - t0, man=man, api=api if api_url else None,
                tracks=[(st[t.label], t.seg_dur) for t in tracks])

def live_verdict(L):
    if L is None:
        return
    man, api = L["man"], L["api"]
    bad = []
    if man.fail:
        bad.append(f"{man.fail}/{man.n} manifest refreshes failed")
    for s, sd in L["tracks"]:
        if s.fail:
            bad.append(f"{s.fail}/{s.n} {s.name} segments failed")
        if s.gap > 3 * sd:
            bad.append(f"{s.name} went {s.gap:.0f}s without a new segment")
    if api and api.fail:
        bad.append(f"{api.fail}/{api.n} Pilot WP API checks failed")
    slow = ([f"manifest up to {man.max*1000:.0f}ms"] if man.slow else []) \
         + [f"{s.name} up to {s.max*1000:.0f}ms" for s, _ in L["tracks"] if s.slow] \
         + ([f"Pilot WP API up to {api.max*1000:.0f}ms"] if api and api.slow else [])
    if bad:
        print(f"  LIVE: the link is UNSTABLE - over {L['secs']:.0f}s: " + "; ".join(bad) + ".")
        print("          Playback stalls and stops like this, and a re-tune can't reach the server (the "
              "connection slate). The burst timings above can't show it: they last a few seconds. "
              "Check the modem/line (resyncs, errors) and re-run with a longer --live.")
    elif slow:
        print(f"  LIVE: no failures over {L['secs']:.0f}s, but slow fetches (" + ", ".join(slow) + ") - "
              f"the link stalls at times; playback rides that out only while its buffer lasts.")
    else:
        print(f"  LIVE: stable for {L['secs']:.0f}s - no failures, no slow fetches, no gaps.")

try:
    tracks, refresh, node = run_dash() if mode == "dash" else run_hls()
except urllib.error.HTTPError as e:
    print(f"manifest/playlist fetch failed: HTTP {e.code} {e.reason}\n   {e.url}")
    if e.code == 403:
        print("   -> the URL's tokens were refused (session closed or expired); re-run the probe.")
    sys.exit(1)
except (urllib.error.URLError, OSError) as e:
    print(f"manifest/playlist fetch failed: {type(e).__name__}: {e}")
    sys.exit(1)
try:
    sample(tracks, refresh)
except KeyboardInterrupt:
    sys.exit(130)
res = [t.report() for t in tracks]
L = live(tracks, refresh) if live_secs > 0 and tracks else None

# ---- verdict -----------------------------------------------------------------
print("VERDICT")
if not res:
    print("  no track could be probed (no video/audio segments found in the manifest).")
for r in res:
    sd = r["seg_dur"]; warm = r["warm"]; cold = r["cold"]; lab = r["label"]
    if r["warm_err"] or r["cold_err"]:
        print(f"  {lab}: {r['warm_err']} WARM / {r['cold_err']} COLD fetch(es) failed (HTTP error or "
              f"connection error) — failed fetches stall playback on their own.")
    if not r["warm_ok"] or not r["cold_ok"]:
        print(f"  {lab}: not enough successful fetches (WARM {r['warm_ok']}, COLD {r['cold_ok']}) for a "
              f"verdict — the path is failing outright; run the probe again.")
        continue
    if r["reconnects"]:
        print(f"  {lab}: {r['reconnects']} keep-alive RECONNECT(s) during the run — the connection is "
              f"being dropped mid-stream (link loss / idle reset). That alone causes stalls.")
    warm_ok, cold_ok = warm <= sd, cold <= sd
    if warm_ok and cold_ok:
        print(f"  {lab}: WARM {warm*1000:.0f}ms/seg and COLD {cold*1000:.0f}ms/seg <= {sd*1000:.0f}ms "
              f"budget -> keeps up.")
    elif warm_ok:
        print(f"  {lab}: WARM {warm*1000:.0f}ms/seg keeps up, BUT COLD {cold*1000:.0f}ms/seg > "
              f"{sd*1000:.0f}ms budget -> NEW connections are slow; any reconnect stalls. Suspect a full "
              f"nf_conntrack table / socket buildup (check it; a reboot clears it).")
    elif cold_ok:
        print(f"  {lab}: WARM {warm*1000:.0f}ms/seg > {sd*1000:.0f}ms budget, but COLD "
              f"{cold*1000:.0f}ms/seg keeps up -> fresh connections are fast, the reused one stalls. "
              f"Bandwidth is fine; long-lived connections are being held up or dropped on the way "
              f"(router/NAT/Wi-Fi, or the CDN node {node}). Compare from another machine on the same "
              f"network and re-run to see whether it follows the node.")
    else:
        xfer_bound = r["warm_xfer"] > r["warm_ttfb"]
        dom = "transfer (bandwidth)" if xfer_bound else "TTFB/latency (link RTT or server wait)"
        print(f"  {lab}: WARM {warm*1000:.0f}ms/seg and COLD {cold*1000:.0f}ms/seg > {sd*1000:.0f}ms "
              f"budget -> CANNOT keep up on any connection. Dominated by {dom}.")
        if lab in ("VIDEO", "STREAM") and xfer_bound:
            if mode == "dash":
                print(f"          -> capping the video bitrate (--max-video-bw in PILOT_WP_DASHLIVE_ARGS) should help.")
            else:
                print(f"          -> the HLS path can't cap the bitrate; the DASH path can (--max-video-bw in "
                      f"PILOT_WP_DASHLIVE_ARGS). Re-run with --dash to see whether this channel has it.")
        else:
            print(f"          -> a bitrate cap won't fix latency; this is the link/path (compare against a "
                  f"healthy box or run from elsewhere).")
live_verdict(L)
